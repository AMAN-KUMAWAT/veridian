# backend/.env.example — copy to backend/.env and fill in real values.
# DO NOT commit the real .env file. Real secrets stay out of Git.

MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
CORS_ORIGINS="*"

# Managed email (Resend) proxy key that delivers OTP login emails.
# To use your own Resend account instead, put your RESEND_API_KEY here and
# switch send_otp_email() in server.py to call https://api.resend.com/emails.
EMERGENT_EMAIL_KEY=your_managed_email_key_here
EMAIL_FROM_NAME=Veridian

# Universal LLM key powering the Claude AI insight.
# To use your own Anthropic account, put your ANTHROPIC_API_KEY here and switch
# the /api/submissions/{id}/ai-insight endpoint to the Anthropic SDK.
EMERGENT_LLM_KEY=your_universal_llm_key_here

# Comma-separated emails allowed to log in to the Insights Dashboard.
WHITELIST_EMAILS=user1@example.com,user2@example.com,user3@example.com

# Long random string used to sign session tokens. CHANGE THIS in production.
JWT_SECRET=change_me_to_a_long_random_secret
